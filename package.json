{
  "name": "ovoo",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"bunx --bun vite\" \"wrangler dev\"",
    "dev:bun": "concurrently \"VITE_BACKEND=bun bunx --bun vite\" \"bun run src/entry.bun.dev.ts\"",
    "dev:vite": "bunx --bun vite",
    "dev:worker": "wrangler dev",
    "dev:api": "bun run src/entry.bun.dev.ts",
    "build": "bunx --bun vite build",
    "build:bun": "bun build src/entry.bun.ts --outdir=dist-bun --target=bun --minify",
    "build:all": "bun run build && bun run build:bun",
    "preview": "bunx --bun vite preview",
    "deploy:cf": "bun run build && wrangler deploy",
    "docker:build": "bun run build:all && docker build -t ovoo .",
    "lint": "bunx eslint src/",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.10",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@happy-dom/global-registrator": "^20.14.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "wrangler": "^4.147.0"
  }
}
